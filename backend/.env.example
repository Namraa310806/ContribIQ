# Copy to backend/.env and fill in your own values. Never commit the real file.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="contribiq"
CORS_ORIGINS="*"
APP_URL=http://localhost:3000
# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Callback URL for local use: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# LLM key for classification / insights / job tailoring — any OpenAI-compatible provider
# (OpenAI, OpenRouter, Groq, Together, local vLLM...). Optional: heuristics cover its absence.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Shared secret for the scheduled weekly-sync webhook (any long random string)
WEBHOOK_CRON_SECRET=
